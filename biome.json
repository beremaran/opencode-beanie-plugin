{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "correctness": {
        "noNodejsModules": "off",
        "noProcessGlobal": "off",
        "useQwikValidLexicalScope": "off",
        "useImportExtensions": "off"
      },
      "style": {
        "noDefaultExport": "off",
        "noProcessEnv": "off",
        "noNamespace": "off"
      },
      "suspicious": {
        "noConsole": "off"
      },
      "security": {
        "noSecrets": "off"
      },
      "complexity": {
        "noVoid": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "attributePosition": "multiline",
      "jsxQuoteStyle": "double",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  }
}
