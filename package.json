{
  "name": "@beremaran/opencode-beanie-plugin",
  "version": "0.2.1",
  "description": "Combined OpenCode plugin: agent orchestration, subagent throttling, persistent goals, OpenAI-compatible provider auto-configuration, MCP tool aggregation, and skill discovery.",
  "license": "MIT",
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-beanie-plugin.git"
  },
  "homepage": "https://github.com/beremaran/opencode-beanie-plugin",
  "bugs": {
    "url": "https://github.com/beremaran/opencode-beanie-plugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent-orchestration",
    "subagent",
    "throttle",
    "goals",
    "mcp",
    "skills",
    "provider",
    "openai-compatible"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "lint:fix-all": "biome check --write --unsafe",
    "format": "biome format --write src",
    "format:check": "biome format src"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@opencode-ai/plugin": "1.18.16",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "typescript": "^5.0.0"
  }
}
