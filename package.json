{
  "name": "@beremaran/opencode-beanie-plugin",
  "version": "2.0.0",
  "description": "Combined OpenCode plugin: agent orchestration, subagent throttling, persistent goals, MCP tool aggregation, skill discovery, and TUI companion.",
  "license": "MIT",
  "author": "Berke Arslan <berke@beremaran.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beremaran/opencode-beanie-plugin.git"
  },
  "homepage": "https://github.com/beremaran/opencode-beanie-plugin",
  "bugs": {
    "url": "https://github.com/beremaran/opencode-beanie-plugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent-orchestration",
    "subagent",
    "throttle",
    "goals",
    "mcp",
    "skills",
    "tui",
    "opentui"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "module": "dist/index.js",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./src/tui.tsx",
      "import": "./dist/tui.js"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check-structure": "bun scripts/check-structure.ts",
    "test": "bun test",
    "build": "bun build src/index.ts src/tui.tsx --outdir dist --target bun --format esm --external @opencode-ai/plugin --external @opencode-ai/plugin/tui --external @opencode-ai/sdk --external @opencode-ai/sdk/v2 --external @opentui/solid --external solid-js",
    "commit": "make commit"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "latest",
    "eslint": "^9.34.0",
    "typescript-eslint": "^8.41.0"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.4.5",
    "solid-js": "1.9.12",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@opencode-ai/plugin": "^1.18.18"
  }
}
